{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local shell windows may launch the bundled Miyabi server.",
  "windows": ["main", "setup"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "miyabi-server", "sidecar": true, "args": true }]
    }
  ]
}
