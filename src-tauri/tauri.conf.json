{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miyabi",
  "version": "0.4.0",
  "identifier": "com.ppxb.miyabi.desktop",
  "build": {
    "frontendDist": "stub"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/miyabi-server"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
